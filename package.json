{
  "name": "drive-clone",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "test": "npm test -w server",
    "db:local": "npm run db:local -w server",
    "db:push": "npm run db:push -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true,
    "@prisma/engines@6.19.3": true
  }
}
