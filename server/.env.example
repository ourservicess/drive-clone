# --- Server ------------------------------------------------
NODE_ENV=development
PORT=3000
# The URL where the React app is opened in the browser (used for CORS + CSRF checks)
WEB_ORIGIN=http://localhost:5173
# Set to true ONLY when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# --- Database (MongoDB, must be a replica set) -------------
# Local (started with `npm run db:local`):
DATABASE_URL=mongodb://127.0.0.1:27017/drive_clone?replicaSet=rs0
# MongoDB Atlas (free cloud) instead - copy the string from Atlas > Connect > Drivers
# and put the database name before the "?":
# DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/drive_clone?retryWrites=true&w=majority
# (Tests use their own throwaway in-memory MongoDB; no test database is needed.)

# --- Auth --------------------------------------------------
SESSION_TTL_DAYS=7

# --- Uploads -----------------------------------------------
MAX_UPLOAD_MB=100
STORAGE_QUOTA_MB=5120

# --- File storage -------------------------------------------
# local = save uploaded files in a folder on this computer
# r2    = save them in Cloudflare R2 (fill in the R2_ values below)
STORAGE_DRIVER=local
# Folder used when STORAGE_DRIVER=local (relative to the server/ folder)
LOCAL_STORAGE_DIR=./storage

# --- Cloudflare R2 (only used when STORAGE_DRIVER=r2; keep the bucket PRIVATE)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=drive-clone
