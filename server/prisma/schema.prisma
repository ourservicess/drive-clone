// MongoDB schema. MongoDB has no tables or migrations: `prisma db push`
// creates the collections' indexes, and `prisma generate` builds the client.
// Prisma needs MongoDB to run as a replica set (for transactions);
// `npm run db:local` and MongoDB Atlas both provide one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  folders      Folder[]
  files        File[]
}

model Session {
  /// SHA-256 hash of the cookie token. The raw token is never stored.
  id        String   @id @map("_id")
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Folder {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  ownerId           String    @db.ObjectId
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// null = top level of "My Drive"
  parentId          String?   @db.ObjectId
  // MongoDB has no foreign keys: deleting a folder tree is done explicitly in
  // trashService.ts (NoAction is required by Prisma for self-relations on MongoDB).
  parent            Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          Folder[]  @relation("FolderTree")
  files             File[]
  /// null = not in Trash
  trashedAt         DateTime?
  /// true = the user deleted THIS item (it is shown in the Trash view)
  trashedExplicitly Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([ownerId, parentId, trashedAt])
  @@index([ownerId, trashedExplicitly])
}

model File {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  /// Display name only - never used as a storage path
  name              String
  mimeType          String
  /// Size in bytes
  size              BigInt
  /// Generated by the server: users/<userId>/<uuid>
  storageKey        String    @unique
  ownerId           String    @db.ObjectId
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// null = top level of "My Drive"
  folderId          String?   @db.ObjectId
  folder            Folder?   @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  starred           Boolean   @default(false)
  /// true = a public share link exists (null on files created before sharing existed)
  shared            Boolean?
  /// Drives the "Recent" view
  lastAccessedAt    DateTime  @default(now())
  trashedAt         DateTime?
  trashedExplicitly Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([ownerId, folderId, trashedAt])
  @@index([ownerId, starred])
  @@index([ownerId, lastAccessedAt])
  @@index([ownerId, name])
}

enum UploadStatus {
  uploading // in progress, or interrupted and waiting to be resumed
  completed
  cancelled
  failed
  expired // abandoned for too long; partial data was deleted
}

/// One resumable upload. The file is sent in numbered chunks; receivedBytes
/// records how far it got, so an interrupted upload can continue from there.
/// These documents are also the user's upload history.
model Upload {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  ownerId       String       @db.ObjectId
  /// Cleaned display name the file will get
  name          String
  mimeType      String
  size          BigInt
  /// Destination folder chosen when the upload started (null = My Drive)
  folderId      String?      @db.ObjectId
  /// Where the bytes are stored (generated by the server)
  storageKey    String       @unique
  /// Upload id from the storage provider (R2 multipart uploads); null for local storage
  multipartId   String?
  chunkSize     Int
  receivedBytes BigInt       @default(0)
  status        UploadStatus
  /// "size:lastModified:name" of the browser file - used to check that the
  /// user picked the SAME file when resuming (not used for security)
  fingerprint   String
  /// The File created when the upload completed
  fileId        String?      @db.ObjectId
  error         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  completedAt   DateTime?

  @@index([ownerId, createdAt])
  @@index([status, updatedAt])
}

/// A public "anyone with the link can view" link for one file.
model ShareLink {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Random, unguessable token used in the public URL /s/<token>
  token         String   @unique
  fileId        String   @unique @db.ObjectId
  ownerId       String   @db.ObjectId
  /// false = viewers can only preview in the browser (no download button)
  allowDownload Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId])
}
